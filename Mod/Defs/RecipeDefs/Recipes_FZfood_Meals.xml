<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    The original mod shipped its own <RecipeDef Name="CookMealBase" Abstract="True"> here: a copy
    of the vanilla base every cooking recipe inherits from. Two abstract defs may share a Name
    without any error: GetBestParentFor resolves each ParentName to the copy from the
    highest-loading mod at or below the def asking for it, so this copy would quietly have stood
    in for Ludeon's on every vanilla meal recipe loading after it - and being a 1.0 copy, it was
    missing the Anomaly exclusion of twisted meat. Not one of the fifteen recipes below ever
    inherited from it. It is gone.

    Wheat: each recipe takes this mod's FZRawWheat, and also Mlie's RawWheat where that mod is
    loaded, so a colony that already grows wheat does not have to grow a second kind.

    Eggs: the egg biscuit asked for EggChickenUnfertilized by name, which locked out the six
    other vanilla eggs - duck, goose, turkey, emu, ostrich, cassowary - and every modded bird.
    It now takes the EggsUnfertilized category.
  -->

  <!-- egg biscuit -->

  <RecipeDef>
    <defName>CookFZEggBiscuit</defName>
    <label>bake egg biscuits</label>
    <description>Bake egg biscuits from wheat grain and eggs.</description>
    <jobString>Baking biscuits.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <workAmount>300</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>FZRawWheat</li>
            <li MayRequire="Mlie.VanillalikeWheat">RawWheat</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>EggsUnfertilized</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>FZRawWheat</li>
        <li MayRequire="Mlie.VanillalikeWheat">RawWheat</li>
      </thingDefs>
      <categories>
        <li>EggsUnfertilized</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <FZEggBiscuit>5</FZEggBiscuit>
    </products>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

