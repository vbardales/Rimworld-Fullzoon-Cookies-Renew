<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Every biscuit is a gluttonous snack in the mould of vanilla chocolate: barely any nutrition,
    DesperateOnly so colonists never treat one as a meal, and joy when eaten for pleasure.
  -->

  <ThingDef Name="FZSnackBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>100</stackLimit>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>0</Beauty>
      <Mass>0.01</Mass>
      <DeteriorationRate>5</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Ingredients" />
      <li Class="CompProperties_FoodPoisonable" />
    </comps>
    <tradeability>Buyable</tradeability>
    <alwaysHaulable>true</alwaysHaulable>
    <tickerType>Rare</tickerType>
    <socialPropernessMatters>true</socialPropernessMatters>
    <thingCategories>
      <li>FoodMeals</li>
    </thingCategories>
    <drawGUIOverlay>true</drawGUIOverlay>
    <uiIconForStackCount>1</uiIconForStackCount>
    <rotatable>false</rotatable>
    <pathCost>15</pathCost>
    <ingestible>
      <preferability>DesperateOnly</preferability>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="FZSnackBase">
    <defName>FZEggBiscuit</defName>
    <label>egg biscuit</label>
    <description>A plain little biscuit of wheat flour and egg. Easy to make, mildly sweet, and eaten everywhere.</description>
    <graphicData>
      <texPath>Things/Item/EggBiscuit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>3</MarketValue>
      <Mass>0.05</Mass>
      <Nutrition>0.09</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Processed</foodType>
      <joy>0.1</joy>
      <joyKind>Gluttonous</joyKind>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <ingestSound>Meal_Eat</ingestSound>
      <tasteThought>AteFZEggBiscuit</tasteThought>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="FZSnackBase">
    <defName>FZChocolateCookies</defName>
    <label>chocolate chip cookie</label>
    <description>A western biscuit with chocolate baked through it. It is hard to find anyone who turns one down.</description>
    <graphicData>
      <texPath>Things/Item/ChocolateCookies</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>3.6</MarketValue>
      <Mass>0.05</Mass>
      <Nutrition>0.09</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Processed</foodType>
      <joy>0.13</joy>
      <joyKind>Gluttonous</joyKind>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <ingestSound>Meal_Eat</ingestSound>
      <tasteThought>AteFZChocolateCookies</tasteThought>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="FZSnackBase">
    <defName>FZCookies</defName>
    <label>butter cookie</label>
    <description>A rich western cream biscuit. In some places baking them is a holiday custom: you book an hour at a cookie workshop, follow the baker's instructions, and hand the batch to the people you are fond of.</description>
    <graphicData>
      <texPath>Things/Item/Cookies</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>4.3</MarketValue>
      <Mass>0.05</Mass>
      <Nutrition>0.09</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Processed</foodType>
      <joy>0.15</joy>
      <joyKind>Gluttonous</joyKind>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <ingestSound>Meal_Eat</ingestSound>
      <tasteThought>AteFZCookies</tasteThought>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="FZSnackBase">
    <defName>FZBerryBiscuits</defName>
    <label>berry biscuit</label>
    <description>Berries baked into the dough, a pairing that works better than it sounds. There is enough vitamin C left in them to be worth something.</description>
    <graphicData>
      <texPath>Things/Item/BerryBiscuits</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>2.8</MarketValue>
      <Mass>0.05</Mass>
      <Nutrition>0.09</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Processed</foodType>
      <joy>0.08</joy>
      <joyKind>Gluttonous</joyKind>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <ingestSound>Meal_Eat</ingestSound>
      <tasteThought>AteFZBerryBiscuits</tasteThought>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="FZSnackBase">
    <defName>FZInsectJellyBiscuits</defName>
    <label>insect jelly biscuit</label>
    <description>A biscuit of wheat flour and insect jelly. Against all expectation it tastes of apple, and you find yourself reaching for another.</description>
    <graphicData>
      <texPath>Things/Item/InsectJellyBiscuits</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>5.5</MarketValue>
      <Mass>0.05</Mass>
      <Nutrition>0.09</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Processed</foodType>
      <joy>0.2</joy>
      <joyKind>Gluttonous</joyKind>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <ingestSound>Meal_Eat</ingestSound>
      <tasteThought>AteFZInsectJellyBiscuits</tasteThought>
    </ingestible>
  </ThingDef>

</Defs>
