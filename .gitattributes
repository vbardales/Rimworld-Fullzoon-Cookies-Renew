# Normalise line endings in this repository, while each machine keeps its own
# working copy in the form it prefers.

* text=auto

*.xml   text
*.md    text
*.txt   text

*.png binary

# The pass maps are read by a `while read` loop in the WSL staging: a carriage return on a Workshop id
# would make it a different id, in silence. Features are read by Pickle on Linux.
*.map      text eol=lf
*.feature  text eol=lf
